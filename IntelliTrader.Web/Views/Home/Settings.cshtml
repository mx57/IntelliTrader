@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    ViewData["Instance"] = Model.InstanceName;
    ViewData["CustomPageHeader"] = true;
}

@section AddToHead{
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Static/Styles/Vendor/jsoneditor.min.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Static/Styles/Views/settings.css")">
    <script type="text/javascript" src="@Url.Content("~/Static/Scripts/Vendor/jsoneditor.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Static/Scripts/Views/settings.js")"></script>
}

<div style="clear: both">
    @using (Html.BeginForm())
    {
    <div class="settings">
        <div>@Html.CheckBoxFor(model => model.BuyEnabled)@Html.LabelFor(model => model.BuyEnabled)</div>
        <div>@Html.CheckBoxFor(model => model.BuyDCAEnabled)@Html.LabelFor(model => model.BuyDCAEnabled)</div>
        <div>@Html.CheckBoxFor(model => model.SellEnabled)@Html.LabelFor(model => model.SellEnabled)</div>
        <div>@Html.CheckBoxFor(model => model.HealthCheckEnabled)@Html.LabelFor(model => model.HealthCheckEnabled)</div>
        <div>@Html.CheckBoxFor(model => model.TradingSuspended)@Html.LabelFor(model => model.TradingSuspended)</div>
        <button type="submit" class="btn btn-primary settings-btn" onclick="return confirm('Save settings?');" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Save</button>
    </div>
    }

    <!-- Настройки темы оформления -->
    <div class="settings" style="margin-top: 15px; margin-bottom: 15px;">
        <label for="themeSelect" style="font-weight: bold; margin-right: 10px;">Тема оформления:</label>
        <select id="themeSelect" class="form-control form-control-sm" style="display: inline-block; width: auto; background-color: var(--input-bg); color: var(--text-color); border: 1px solid var(--input-border);">
            <option value="dark">Темная тема (Dark)</option>
            <option value="light">Светлая тема (Light)</option>
        </select>
    </div>

    <button class="btn btn-info settings-btn" onclick="logout();" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Log Out</button>
    <button class="btn btn-info settings-btn" onclick="refreshAccount();" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Refresh Account</button>
    <button class="btn btn-info settings-btn" onclick="restartServices();" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Restart Services</button>

    <div class="configs mt-4" style="background-color: var(--card-bg) !important; border: 1px solid var(--border-color) !important; color: var(--text-color) !important; padding: 20px; border-radius: 4px; margin-top: 20px;">
        <h2>Оформление</h2>
        <div style="margin-bottom: 15px; display: flex; align-items: center;">
            <label style="margin-right: 15px; margin-bottom: 0; font-weight: bold;">Тема оформления:</label>
            <select id="settingsThemeSelect" class="form-control form-control-sm" style="width: auto; background-color: var(--input-bg); color: var(--text-color); border: 1px solid var(--input-border); border-radius: 4px;">
                <option value="dark">Темная (по умолчанию)</option>
                <option value="light">Светлая</option>
            </select>
        </div>
    </div>

    <div class="configs mt-4" style="background-color: var(--card-bg) !important; border: 1px solid var(--border-color) !important; color: var(--text-color) !important; padding: 20px; border-radius: 4px; margin-top: 20px;">
        <h2>Уведомления и Звук</h2>
        <div style="margin-bottom: 15px; display: flex; align-items: center; flex-wrap: wrap;">
            <div style="margin-right: 25px; margin-bottom: 10px; display: flex; align-items: center;">
                <input type="checkbox" id="settingsSoundEnabled" style="margin-right: 8px; width: 16px; height: 16px; cursor: pointer;" />
                <label for="settingsSoundEnabled" style="margin-bottom: 0; font-weight: bold; cursor: pointer;">Включить звуковые оповещения</label>
            </div>
        </div>
        <div style="margin-bottom: 15px; display: flex; align-items: center; flex-wrap: wrap;">
            <label style="margin-right: 15px; margin-bottom: 0; font-weight: bold; min-width: 160px;">Громкость:</label>
            <input type="range" id="settingsSoundVolume" min="0" max="1" step="0.05" value="0.5" style="width: 180px; height: 4px; background: var(--bg-color); outline: none; margin-right: 10px; cursor: pointer;" />
            <span id="settingsSoundVolumeValue" style="font-weight: bold; color: #7aa2f7; min-width: 45px;">50%</span>
        </div>
        <div style="margin-bottom: 15px; display: flex; align-items: center; flex-wrap: wrap;">
            <label style="margin-right: 15px; margin-bottom: 0; font-weight: bold; min-width: 160px;">Профиль звука:</label>
            <select id="settingsSoundProfile" class="form-control form-control-sm" style="width: auto; background-color: var(--input-bg); color: var(--text-color); border: 1px solid var(--input-border); border-radius: 4px;">
                <option value="chime">Приятный звон (Chime)</option>
                <option value="beep">Высокий писк (Beep)</option>
                <option value="arcade">Ретро аркада (Arcade)</option>
            </select>
        </div>
        <div style="margin-bottom: 10px; display: flex; align-items: center; flex-wrap: wrap;">
            <label style="margin-right: 15px; margin-bottom: 0; font-weight: bold; min-width: 160px;">Мин. сумма сделки ($):</label>
            <input type="number" id="settingsMinTradeSize" min="0" step="5" value="0" class="form-control form-control-sm" style="width: 120px; background-color: var(--input-bg); color: var(--text-color); border: 1px solid var(--input-border); border-radius: 4px;" />
            <small class="text-muted ml-2" style="font-size: 11px;">(Уведомления показываются только для сделок от этой суммы в USDT)</small>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const select = document.getElementById("settingsThemeSelect");
            if (select) {
                const currentTheme = localStorage.getItem("theme") || "dark";
                select.value = currentTheme;
                select.addEventListener("change", function() {
                    const targetTheme = select.value;
                    if (targetTheme === "light") {
                        document.documentElement.classList.add("light-theme");
                    } else {
                        document.documentElement.classList.remove("light-theme");
                    }
                    localStorage.setItem("theme", targetTheme);

                    // Sync the header toggle if it exists
                    const themeToggleIcon = document.getElementById("themeToggleIcon");
                    const themeToggleText = document.getElementById("themeToggleText");
                    if (themeToggleIcon) {
                        themeToggleIcon.className = targetTheme === "light" ? "fas fa-sun" : "fas fa-moon";
                        themeToggleIcon.style.color = targetTheme === "light" ? "#f39c12" : "#f1c40f";
                    }
                    if (themeToggleText) {
                        themeToggleText.textContent = targetTheme === "light" ? "Светлая тема" : "Темная тема";
                    }

                    // Dispatch global event
                    const event = new CustomEvent("themeChanged", { detail: { theme: targetTheme } });
                    document.dispatchEvent(event);
                });

                // Sync the settings select if changed from outside (e.g. navbar toggle)
                document.addEventListener("themeChanged", function(e) {
                    if (select && select.value !== e.detail.theme) {
                        select.value = e.detail.theme;
                    }
                });
            }

            // Notification settings logic
            const soundEnabledCheckbox = document.getElementById("settingsSoundEnabled");
            const soundVolumeSlider = document.getElementById("settingsSoundVolume");
            const soundVolumeValue = document.getElementById("settingsSoundVolumeValue");
            const soundProfileSelect = document.getElementById("settingsSoundProfile");
            const minTradeSizeInput = document.getElementById("settingsMinTradeSize");

            if (soundEnabledCheckbox && soundVolumeSlider && soundProfileSelect && minTradeSizeInput) {
                const isSoundEnabled = localStorage.getItem("realtime_sound_enabled") !== "false";
                const volumeVal = localStorage.getItem("realtime_sound_volume") !== null ? parseFloat(localStorage.getItem("realtime_sound_volume")) : 0.5;
                const profileVal = localStorage.getItem("realtime_sound_profile") || "chime";
                const minSizeVal = localStorage.getItem("realtime_min_trade_size") !== null ? parseFloat(localStorage.getItem("realtime_min_trade_size")) : 0;

                soundEnabledCheckbox.checked = isSoundEnabled;
                soundVolumeSlider.value = volumeVal;
                soundVolumeValue.textContent = Math.round(volumeVal * 100) + "%";
                soundProfileSelect.value = profileVal;
                minTradeSizeInput.value = minSizeVal;

                soundEnabledCheckbox.addEventListener("change", function() {
                    localStorage.setItem("realtime_sound_enabled", soundEnabledCheckbox.checked);
                });

                soundVolumeSlider.addEventListener("input", function() {
                    const val = parseFloat(soundVolumeSlider.value);
                    soundVolumeValue.textContent = Math.round(val * 100) + "%";
                    localStorage.setItem("realtime_sound_volume", val);
                });

                soundProfileSelect.addEventListener("change", function() {
                    localStorage.setItem("realtime_sound_profile", soundProfileSelect.value);
                });

                minTradeSizeInput.addEventListener("input", function() {
                    const val = Math.max(0, parseFloat(minTradeSizeInput.value) || 0);
                    localStorage.setItem("realtime_min_trade_size", val);
                });
            }
        });
    </script>

    <div class="configs">
        <h2>Advanced</h2>

        <ul class="nav nav-pills bg-dark">
            @foreach (var configName in Model.Configs.Keys)
            {
            <li class="nav-item">
                <a class="nav-link" data-toggle="pill" href="#tab_@configName" role="tab">@configName</a>
            </li>
            }
        </ul>

        <div class="tab-content">
        @foreach (var kvp in Model.Configs)
        {
            <div class="tab-pane" id="tab_@kvp.Key">
                <div class="config-container">
                    <div class="config-value" id="@Html.Raw(kvp.Key + "Value")" data-config="@kvp.Key">@Html.Raw(kvp.Value)</div>
                    <div class="config-editor" id="@Html.Raw(kvp.Key + "Editor")" data-config="@kvp.Key"></div>
                </div>
                <div class="config-options bg-dark">
                    <span class="save-config-status" id="saveConfigStatus"></span>
                    <button class="btn btn-primary" onclick="saveConfig(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Save</button>
                </div>
            </div>
        }
        </div>
    </div>
</div>