@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Instance"] = Model.InstanceName;
}

@section AddToHead{
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Static/Styles/Views/dashboard.css")">
    <script type="text/javascript" src="@Url.Content("~/Static/Scripts/Views/dashboard.js")"></script>
}

<div>
    <table class="table table-hover table-striped" id="tradingPairsTable" style="width: 100%">
        <thead>
            <tr>
                <th>More</th>
                <th>Pair</th>
                <th>Pair</th>
                <th>DCA</th>
                <th>Margin</th>
                <th>Target</th>
                <th>Rating</th>
                <th>Rating Bought</th>
                <th>Age</th>
                <th>Amount</th>
                <th>Cost</th>
                <th>Cost Bought</th>
                <th>Price</th>
                <th>Price Bought</th>
                <th>Spread</th>
                <th>Signal Rule</th>
                <th>Trading Rules</th>
                <th>Order Dates</th>
                <th>Order Ids</th>
            </tr>
        </thead>
        <tfoot>
            <tr>
                <th></th>
                <th>Total</th>
                <th>Total</th>
                <th></th>
                <th>Avg</th>
                <th></th>
                <th>Avg</th>
                <th>Avg</th>
                <th>Avg</th>
                <th></th>
                <th>Total</th>
                <th>Total</th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <!-- Real-time Log Monitor Terminal -->
    <div class="card mt-4" style="background-color: #1e1e2f; color: #a9b7c6; border-radius: 4px; border: 1px solid #2b2b36; margin-top: 20px;">
        <div class="card-header" style="background-color: #2b2b36; border-bottom: 1px solid #32324d; padding: 10px 15px; display: flex; align-items: center; justify-content: space-between;">
            <h5 class="mb-0" style="color: #ffffff; font-size: 16px; margin: 0;"><i class="fas fa-terminal mr-2"></i>Live Log Monitor</h5>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-sm btn-outline-light active" id="logTypeGeneralBtn" style="border-color: #4a4a6a; margin-right: 5px;" onclick="setLogType('general')">General Log</button>
                <button type="button" class="btn btn-sm btn-outline-light" id="logTypeTradesBtn" style="border-color: #4a4a6a;" onclick="setLogType('trades')">Trades Log</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="logTerminal" style="height: 250px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 13px; padding: 15px; background-color: #12121a; color: #39FF14; line-height: 1.5; white-space: pre-wrap; border-radius: 0 0 4px 4px;">
                <div class="text-muted">Initializing log connection...</div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                </div>
                <div class="modal-body" id="modalContent"></div>
                <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/html" id="rowDetails">
        <div>
            <div class="row-details">
                <input type="hidden" id="pair" />
                <div class="additional-details">
                    <div id="swapPairContainer">
                        <span class="row-details-name">Swap Pair:</span>&nbsp;&nbsp;<span class="row-details-value" id="swapPair"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Signal Rule:</span>&nbsp;&nbsp;<span class="row-details-value" id="signalRule"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Trading Rules:</span>&nbsp;&nbsp;<span class="row-details-value" id="tradingRules"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Last Buy Margin:</span>&nbsp;&nbsp;<span class="row-details-value" id="lastBuyMargin"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Bought Price:</span>&nbsp;&nbsp;<span class="row-details-value" id="boughtPrice"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Bought Rating:</span>&nbsp;&nbsp;<span class="row-details-value" id="boughtRating"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Order Dates:</span>&nbsp;&nbsp;<span class="row-details-value" id="orderDates"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Order Ids:</span>&nbsp;&nbsp;<span class="row-details-value" id="orderIds"></span>
                    </div>
                </div>
                <div class="show-settings">
                    <button class="btn btn-sm btn-success" onclick="showSettings(this);">Show Settings</button>
                </div>
                <div class="manual-order">
                    <span>Amount:</span>&nbsp;&nbsp;<input type="text" id="amount" />
                    <button class="btn btn-sm btn-info" onclick="sellPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Sell</button>
                    <button class="btn btn-sm btn-warning" onclick="buyPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Buy</button>
                    <button class="btn btn-sm btn-primary" onclick="swapPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Swap</button>
                </div>
            </div>
        </div>
    </script>

    <div class="card mt-4" style="background-color: #1e1e2e; border: 1px solid #3b3b4f; color: #a9b1d6; font-family: 'Courier New', Courier, monospace;">
        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #1a1a26; border-bottom: 1px solid #3b3b4f;">
            <span style="font-weight: bold; color: #7aa2f7;"><i class="fas fa-terminal"></i> Live Trade Logs Terminal</span>
            <div class="d-flex align-items-center">
                <select id="logTypeSelect" class="form-control form-control-sm d-inline-block" style="width: auto; background-color: #24283b; color: #a9b1d6; border: 1px solid #3b3b4f; margin-right: 10px;">
                    <option value="trades" selected>Trade Logs</option>
                    <option value="general">General Logs</option>
                </select>
                <button id="clearTerminalBtn" class="btn btn-sm btn-outline-secondary" style="border-color: #3b3b4f; color: #a9b1d6;">Clear</button>
            </div>
        </div>
        <div class="card-body" id="logTerminal" style="height: 250px; overflow-y: auto; font-size: 13px; line-height: 1.5; padding: 10px; background-color: #1a1a26; border-radius: 0 0 4px 4px;">
            <div class="text-muted">Initializing live log polling...</div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const logTerminal = document.getElementById("logTerminal");
            const logTypeSelect = document.getElementById("logTypeSelect");
            const clearTerminalBtn = document.getElementById("clearTerminalBtn");

            let lastLogContent = "";

            function fetchLogs() {
                const logType = logTypeSelect.value;
                fetch(`/Home/PollLogs?type=${logType}&maxLines=100`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.lines) {
                            const content = data.lines.join("\n");
                            if (content !== lastLogContent) {
                                lastLogContent = content;

                                logTerminal.innerHTML = "";
                                if (data.lines.length === 0) {
                                    logTerminal.innerHTML = '<div class="text-muted">No logs found.</div>';
                                } else {
                                    data.lines.forEach(line => {
                                        const div = document.createElement("div");
                                        div.style.whiteSpace = "pre-wrap";
                                        div.style.wordBreak = "break-all";
                                        div.style.marginBottom = "4px";

                                        if (line.includes("[ERR]") || line.includes("Error") || line.includes("Exception") || line.includes("fail")) {
                                            div.style.color = "#f7768e";
                                        } else if (line.includes("[WRN]") || line.includes("Warning") || line.includes("warn")) {
                                            div.style.color = "#e0af68";
                                        } else if (line.includes("[INF]") || line.includes("Success") || line.includes("Buy") || line.includes("Sell")) {
                                            div.style.color = "#9ece6a";
                                        } else {
                                            div.style.color = "#a9b1d6";
                                        }

                                        div.textContent = line;
                                        logTerminal.appendChild(div);
                                    });

                                    logTerminal.scrollTop = logTerminal.scrollHeight;
                                }
                            }
                        } else {
                            logTerminal.innerHTML = `<div class="text-danger">Error: ${data.message || 'Unknown error'}</div>`;
                        }
                    })
                    .catch(error => {
                        console.error("Error polling logs:", error);
                        logTerminal.innerHTML = `<div class="text-danger">Connection lost: ${error.message}</div>`;
                    });
            }

            fetchLogs();

            const intervalId = setInterval(fetchLogs, 3000);

            logTypeSelect.addEventListener("change", function() {
                lastLogContent = "";
                logTerminal.innerHTML = '<div class="text-muted">Loading logs...</div>';
                fetchLogs();
            });

            clearTerminalBtn.addEventListener("click", function() {
                logTerminal.innerHTML = '<div class="text-muted">Terminal cleared.</div>';
                lastLogContent = "CLEARED";
            });
        });
    </script>
</div>
