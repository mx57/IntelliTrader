@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Instance"] = Model.InstanceName;
}

@section AddToHead{
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Static/Styles/Views/dashboard.css")">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="text/javascript" src="@Url.Content("~/Static/Scripts/Views/dashboard.js")"></script>
}

<div>
    <!-- Панель мониторинга завершения сделок в реальном времени -->
    <div class="mb-3" style="background-color: #1a1a26; padding: 15px 20px; border-radius: 4px; border: 1px solid #3b3b4f; color: #a9b1d6; margin-bottom: 20px;">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div style="margin-bottom: 10px;">
                <i class="fas fa-bell text-success mr-2" style="color: #9ece6a !important;"></i> <span style="font-size: 14px;">Мониторинг завершения сделок в реальном времени активен.</span>
            </div>
            <div class="d-flex align-items-center flex-wrap" style="margin-bottom: 10px;">
                <button id="soundToggleBtn" class="btn btn-sm btn-outline-success mr-2" style="font-weight: bold; border-color: #9ece6a; color: #9ece6a; background: transparent; transition: all 0.3s;">
                    <i class="fas fa-volume-up mr-1"></i> Звук: Вкл
                </button>
                <button id="testSoundBtn" class="btn btn-sm btn-outline-secondary" style="font-weight: bold; border-color: #4a4a6a; color: #a9b1d6; background: transparent; transition: all 0.3s;">
                    <i class="fas fa-music mr-1"></i> Проверить звук
                </button>
            </div>
        </div>

        <!-- Дополнительные настройки звука -->
        <div class="row align-items-center mt-2 pt-2" style="border-top: 1px solid #2e2e3f; font-size: 13px;">
            <div class="col-md-5 d-flex align-items-center mb-2 mb-md-0">
                <i class="fas fa-sliders-h mr-2" style="color: #7aa2f7;"></i>
                <span class="mr-2" style="white-space: nowrap;">Громкость:</span>
                <input type="range" id="soundVolumeSlider" min="0" max="1" step="0.05" value="0.5" style="flex-grow: 1; height: 4px; background: #24283b; outline: none; transition: background 450ms ease-in-out; -webkit-appearance: none; cursor: pointer;" />
                <span id="soundVolumeValue" class="ml-2" style="font-weight: bold; color: #7aa2f7; min-width: 40px; text-align: right;">50%</span>
            </div>
            <div class="col-md-5 d-flex align-items-center mb-2 mb-md-0">
                <i class="fas fa-music mr-2" style="color: #bb9af3;"></i>
                <span class="mr-2" style="white-space: nowrap;">Профиль звука:</span>
                <select id="soundProfileSelect" class="form-control form-control-sm" style="background-color: #1e1e2e; color: #a9b1d6; border: 1px solid #3b3b4f; border-radius: 4px; height: 28px; padding: 2px 8px; font-size: 12px; width: auto;">
                    <option value="chime">Приятный звон (Chime)</option>
                    <option value="beep">Высокий писк (Beep)</option>
                    <option value="arcade">Ретро аркада (Arcade)</option>
                </select>
            </div>
            <div class="col-md-2 text-md-right text-muted" style="font-size: 11px;">
                Настройки звука
            </div>
        </div>
    </div>

    <div id="notificationContainer" style="position: fixed; top: 80px; right: 20px; z-index: 9999; width: 360px; pointer-events: none;"></div>

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const soundToggleBtn = document.getElementById("soundToggleBtn");
        const testSoundBtn = document.getElementById("testSoundBtn");
        const soundVolumeSlider = document.getElementById("soundVolumeSlider");
        const soundVolumeValue = document.getElementById("soundVolumeValue");
        const soundProfileSelect = document.getElementById("soundProfileSelect");
        const notificationContainer = document.getElementById("notificationContainer");

        let isSoundEnabled = localStorage.getItem("realtime_sound_enabled") !== "false";

        // Load volume with fallback to 0.5
        let soundVolume = localStorage.getItem("realtime_sound_volume");
        if (soundVolume === null) {
            soundVolume = 0.5;
        } else {
            soundVolume = parseFloat(soundVolume);
        }

        // Load sound profile with fallback to 'chime'
        let soundProfile = localStorage.getItem("realtime_sound_profile") || "chime";

        // Sync UI controls with values
        soundVolumeSlider.value = soundVolume;
        soundVolumeValue.textContent = Math.round(soundVolume * 100) + "%";
        soundProfileSelect.value = soundProfile;

        updateSoundButtonUI();

        let knownTrades = new Set();
        let isFirstLoad = true;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx && audioCtx.state === "suspended") {
                audioCtx.resume();
            }
        }

        function playNotificationSound() {
            if (!isSoundEnabled) return;
            try {
                initAudio();
                if (!audioCtx) return;

                const volumeScale = soundVolume;
                if (volumeScale <= 0) return;

                function playTone(freq, type, startTime, duration, volume) {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, startTime);

                    gain.gain.setValueAtTime(volume * volumeScale, startTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);

                    osc.start(startTime);
                    osc.stop(startTime + duration);
                }

                const now = audioCtx.currentTime;

                if (soundProfile === "chime") {
                    // Pleasant Chime (C5, E5, G5)
                    playTone(523.25, 'sine', now, 0.4, 0.1);       // C5
                    playTone(659.25, 'sine', now + 0.1, 0.45, 0.1);  // E5
                    playTone(783.99, 'sine', now + 0.2, 0.5, 0.1);   // G5
                } else if (soundProfile === "beep") {
                    // High Beep (Double crisp high tone)
                    playTone(880.00, 'sine', now, 0.1, 0.15);        // A5
                    playTone(1174.66, 'sine', now + 0.12, 0.15, 0.15); // D6
                } else if (soundProfile === "arcade") {
                    // Retro Arcade (triangle sweep + square arpeggio)
                    const sweepDuration = 0.3;
                    const oscSweep = audioCtx.createOscillator();
                    const gainSweep = audioCtx.createGain();
                    oscSweep.connect(gainSweep);
                    gainSweep.connect(audioCtx.destination);

                    oscSweep.type = 'triangle';
                    oscSweep.frequency.setValueAtTime(150, now);
                    oscSweep.frequency.exponentialRampToValueAtTime(1200, now + sweepDuration);

                    gainSweep.gain.setValueAtTime(0.12 * volumeScale, now);
                    gainSweep.gain.exponentialRampToValueAtTime(0.0001, now + sweepDuration);

                    oscSweep.start(now);
                    oscSweep.stop(now + sweepDuration);

                    // Quick rapid square notes
                    const oscSeq = audioCtx.createOscillator();
                    const gainSeq = audioCtx.createGain();
                    oscSeq.connect(gainSeq);
                    gainSeq.connect(audioCtx.destination);

                    oscSeq.type = 'square';
                    oscSeq.frequency.setValueAtTime(800, now + 0.1);
                    oscSeq.frequency.setValueAtTime(1000, now + 0.15);
                    oscSeq.frequency.setValueAtTime(1200, now + 0.2);

                    gainSeq.gain.setValueAtTime(0.04 * volumeScale, now + 0.1);
                    gainSeq.gain.exponentialRampToValueAtTime(0.0001, now + 0.25);

                    oscSeq.start(now + 0.1);
                    oscSeq.stop(now + 0.25);
                }
            } catch (err) {
                console.error("Failed to play notification sound:", err);
            }
        }

        function updateSoundButtonUI() {
            if (isSoundEnabled) {
                soundToggleBtn.innerHTML = '<i class="fas fa-volume-up mr-1"></i> Звук: Вкл';
                soundToggleBtn.className = "btn btn-sm btn-outline-success mr-2";
                soundToggleBtn.style.color = "#9ece6a";
                soundToggleBtn.style.borderColor = "#9ece6a";
            } else {
                soundToggleBtn.innerHTML = '<i class="fas fa-volume-mute mr-1"></i> Звук: Выкл';
                soundToggleBtn.className = "btn btn-sm btn-outline-secondary mr-2";
                soundToggleBtn.style.color = "#a9b1d6";
                soundToggleBtn.style.borderColor = "#4a4a6a";
            }
        }

        soundToggleBtn.addEventListener("click", function () {
            isSoundEnabled = !isSoundEnabled;
            localStorage.setItem("realtime_sound_enabled", isSoundEnabled);
            updateSoundButtonUI();
            initAudio();
            if (isSoundEnabled) {
                playNotificationSound();
            }
        });

        // Volume slider handling
        soundVolumeSlider.addEventListener("input", function () {
            soundVolume = parseFloat(soundVolumeSlider.value);
            soundVolumeValue.textContent = Math.round(soundVolume * 100) + "%";
            localStorage.setItem("realtime_sound_volume", soundVolume);
        });

        soundVolumeSlider.addEventListener("change", function () {
            initAudio();
            playNotificationSound();
        });

        // Sound profile select handling
        soundProfileSelect.addEventListener("change", function () {
            soundProfile = soundProfileSelect.value;
            localStorage.setItem("realtime_sound_profile", soundProfile);
            initAudio();
            playNotificationSound();
        });

        testSoundBtn.addEventListener("click", function () {
            initAudio();
            const prev = isSoundEnabled;
            isSoundEnabled = true;
            playNotificationSound();
            isSoundEnabled = prev;

            showToastNotification({
                Pair: "BTCUSDT",
                Amount: 0.052,
                AveragePrice: 96450.00,
                SellPrice: 97890.00,
                Profit: 0.07488,
                ProfitMargin: "1.49",
                SellDate: new Date().toISOString().replace('T', ' ').substring(0, 19),
                IsSwap: false,
                IsArbitrage: false
            }, true);
        });

        function showToastNotification(trade, isTest = false) {
            const card = document.createElement("div");
            card.style.pointerEvents = "auto";
            card.style.backgroundColor = "#1f2335";
            card.style.border = "1px solid #3b3b4f";
            card.style.borderRadius = "6px";
            card.style.padding = "15px";
            card.style.marginBottom = "10px";
            card.style.boxShadow = "0 4px 15px rgba(0,0,0,0.5)";
            card.style.color = "#a9b1d6";
            card.style.opacity = "0";
            card.style.transition = "opacity 0.4s ease, transform 0.4s ease";
            card.style.transform = "translateX(50px)";

            const isProfitable = parseFloat(trade.Profit) >= 0;
            const colorAccent = trade.IsSwap ? "#7aa2f7" : (isProfitable ? "#9ece6a" : "#f7768e");
            const profitSign = isProfitable ? "+" : "";

            card.style.borderLeft = `5px solid ${colorAccent}`;

            let titleText = "Сделка завершена!";
            let iconClass = "fa-check-circle";
            if (isTest) {
                titleText = "Проверка уведомления";
                iconClass = "fa-vial";
            } else if (trade.IsSwap) {
                titleText = "Выполнен SWAP!";
                iconClass = "fa-sync-alt";
            } else if (trade.IsArbitrage) {
                titleText = "Выполнен Арбитраж!";
                iconClass = "fa-random";
            } else if (isProfitable) {
                titleText = "Продажа в ПЛЮС!";
                iconClass = "fa-money-bill-wave";
            } else {
                titleText = "Продажа в минус/ноль";
                iconClass = "fa-arrow-down";
            }

            card.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                    <span style="font-weight: bold; color: ${colorAccent}; font-size: 14px;">
                        <i class="fas ${iconClass} mr-1"></i> ${titleText}
                    </span>
                    <button class="close-toast-btn" style="background: none; border: none; color: #565f89; cursor: pointer; padding: 0; font-size: 16px; line-height: 1;">&times;</button>
                </div>
                <div style="font-size: 13px;">
                    <strong>Пара:</strong> <span style="color: #ffffff;">${trade.Pair}</span><br/>
                    <strong>Количество:</strong> ${Number(trade.Amount).toFixed(6)}<br/>
                    <strong>Цена покупки:</strong> ${Number(trade.AveragePrice).toFixed(2)}<br/>
                    <strong>Цена продажи:</strong> ${Number(trade.SellPrice).toFixed(2)}<br/>
                    <strong>Профит:</strong> <span style="font-weight: bold; color: ${isProfitable ? '#9ece6a' : '#f7768e'}">${profitSign}${Number(trade.Profit).toFixed(8)} (${profitSign}${trade.ProfitMargin}%)</span><br/>
                    <span style="font-size: 11px; color: #565f89; display: block; margin-top: 5px;">${trade.SellDate}</span>
                </div>
            `;

            notificationContainer.appendChild(card);

            setTimeout(() => {
                card.style.opacity = "1";
                card.style.transform = "translateX(0)";
            }, 50);

            const closeBtn = card.querySelector(".close-toast-btn");
            closeBtn.addEventListener("click", () => {
                card.style.opacity = "0";
                card.style.transform = "translateX(50px)";
                setTimeout(() => {
                    card.remove();
                }, 400);
            });

            setTimeout(() => {
                if (card.parentNode) {
                    card.style.opacity = "0";
                    card.style.transform = "translateX(50px)";
                    setTimeout(() => {
                        if (card.parentNode) card.remove();
                    }, 400);
                }
            }, 8000);
        }

        function checkNewTrades() {
            if (document.hidden) return;

            fetch("/Home/GetLatestTrades?limit=10")
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.trades) {
                        let hasNewTrade = false;

                        data.trades.forEach(trade => {
                            const tradeId = `${trade.Pair}_${trade.SellDate}`;
                            if (!knownTrades.has(tradeId)) {
                                knownTrades.add(tradeId);

                                if (!isFirstLoad) {
                                    hasNewTrade = true;
                                    showToastNotification(trade);
                                }
                            }
                        });

                        if (hasNewTrade && !isFirstLoad) {
                            playNotificationSound();
                            if (typeof refreshTable === "function") {
                                refreshTable();
                            }
                        }

                        isFirstLoad = false;
                    }
                })
                .catch(error => {
                    console.error("Error polling latest trades:", error);
                });
        }

        checkNewTrades();
        setInterval(checkNewTrades, 5000);
    });
    </script>

    <table class="table table-hover table-striped" id="tradingPairsTable" style="width: 100%">
        <thead>
            <tr>
                <th>More</th>
                <th>Pair</th>
                <th>Pair</th>
                <th>DCA</th>
                <th>Margin</th>
                <th>Target</th>
                <th>Rating</th>
                <th>Rating Bought</th>
                <th>Age</th>
                <th>Amount</th>
                <th>Cost</th>
                <th>Cost Bought</th>
                <th>Price</th>
                <th>Price Bought</th>
                <th>Spread</th>
                <th>Signal Rule</th>
                <th>Trading Rules</th>
                <th>Order Dates</th>
                <th>Order Ids</th>
            </tr>
        </thead>
        <tfoot>
            <tr>
                <th></th>
                <th>Total</th>
                <th>Total</th>
                <th></th>
                <th>Avg</th>
                <th></th>
                <th>Avg</th>
                <th>Avg</th>
                <th>Avg</th>
                <th></th>
                <th>Total</th>
                <th>Total</th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <!-- Online RL Parameter Drift Analytics Chart -->
    <div class="card mt-4" style="background-color: #1e1e2e; border: 1px solid #3b3b4f; color: #a9b1d6; margin-top: 20px;">
        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #1a1a26; border-bottom: 1px solid #3b3b4f; padding: 10px 15px;">
            <span style="font-weight: bold; color: #7aa2f7;"><i class="fas fa-chart-line mr-2"></i>Аналитика дрейфа параметров (Online RL Parameter Drift)</span>
            <span id="chartSourceBadge" class="badge badge-info">Загрузка...</span>
        </div>
        <div class="card-body" style="background-color: #1a1a26; padding: 20px; border-radius: 0 0 4px 4px;">
            <div style="position: relative; height: 320px; width: 100%;">
                <canvas id="parameterDriftChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Real-time Log Monitor Terminal -->
    <div class="card mt-4" style="background-color: #1e1e2f; color: #a9b7c6; border-radius: 4px; border: 1px solid #2b2b36; margin-top: 20px;">
        <div class="card-header" style="background-color: #2b2b36; border-bottom: 1px solid #32324d; padding: 10px 15px; display: flex; align-items: center; justify-content: space-between;">
            <h5 class="mb-0" style="color: #ffffff; font-size: 16px; margin: 0;"><i class="fas fa-terminal mr-2"></i>Live Log Monitor</h5>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-sm btn-outline-light active" id="logTypeGeneralBtn" style="border-color: #4a4a6a; margin-right: 5px;" onclick="setLogType('general')">General Log</button>
                <button type="button" class="btn btn-sm btn-outline-light" id="logTypeTradesBtn" style="border-color: #4a4a6a;" onclick="setLogType('trades')">Trades Log</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="logTerminal" style="height: 250px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 13px; padding: 15px; background-color: #12121a; color: #39FF14; line-height: 1.5; white-space: pre-wrap; border-radius: 0 0 4px 4px;">
                <div class="text-muted">Initializing log connection...</div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                </div>
                <div class="modal-body" id="modalContent"></div>
                <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/html" id="rowDetails">
        <div>
            <div class="row-details">
                <input type="hidden" id="pair" />
                <div class="additional-details">
                    <div id="swapPairContainer">
                        <span class="row-details-name">Swap Pair:</span>&nbsp;&nbsp;<span class="row-details-value" id="swapPair"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Signal Rule:</span>&nbsp;&nbsp;<span class="row-details-value" id="signalRule"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Trading Rules:</span>&nbsp;&nbsp;<span class="row-details-value" id="tradingRules"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Last Buy Margin:</span>&nbsp;&nbsp;<span class="row-details-value" id="lastBuyMargin"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Bought Price:</span>&nbsp;&nbsp;<span class="row-details-value" id="boughtPrice"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Bought Rating:</span>&nbsp;&nbsp;<span class="row-details-value" id="boughtRating"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Order Dates:</span>&nbsp;&nbsp;<span class="row-details-value" id="orderDates"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Order Ids:</span>&nbsp;&nbsp;<span class="row-details-value" id="orderIds"></span>
                    </div>
                    <div class="mt-3">
                        <span class="row-details-name" style="font-weight: bold; color: #7aa2f7; display: block; margin-bottom: 5px;">
                            <i class="fas fa-layer-group mr-1"></i> DCA Levels Breakdown:
                        </span>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered dca-levels-table" style="font-size: 11px; max-width: 500px; background-color: #1a1a26; color: #a9b1d6; margin-bottom: 0;">
                                <thead style="background-color: #1e1e2f;">
                                    <tr>
                                        <th style="padding: 4px 8px; border-color: #2b2b36;">Level</th>
                                        <th style="padding: 4px 8px; border-color: #2b2b36;">Target Margin</th>
                                        <th style="padding: 4px 8px; border-color: #2b2b36;">Trigger Price</th>
                                        <th style="padding: 4px 8px; border-color: #2b2b36;">Multiplier</th>
                                        <th style="padding: 4px 8px; border-color: #2b2b36;">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="dcaLevelsBody">
                                    <!-- Populated dynamically -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="show-settings">
                    <button class="btn btn-sm btn-success" onclick="showSettings(this);">Show Settings</button>
                </div>
                <div class="manual-order">
                    <span>Amount:</span>&nbsp;&nbsp;<input type="text" id="amount" />
                    <button class="btn btn-sm btn-info" onclick="sellPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Sell</button>
                    <button class="btn btn-sm btn-warning" onclick="buyPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Buy</button>
                    <button class="btn btn-sm btn-primary" onclick="swapPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Swap</button>
                </div>
            </div>
        </div>
    </script>

    <div class="card mt-4" style="background-color: #1e1e2e; border: 1px solid #3b3b4f; color: #a9b1d6; font-family: 'Courier New', Courier, monospace;">
        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #1a1a26; border-bottom: 1px solid #3b3b4f;">
            <span style="font-weight: bold; color: #7aa2f7;"><i class="fas fa-terminal"></i> Live Trade Logs Terminal</span>
            <div class="d-flex align-items-center">
                <select id="logTypeSelect" class="form-control form-control-sm d-inline-block" style="width: auto; background-color: #24283b; color: #a9b1d6; border: 1px solid #3b3b4f; margin-right: 10px;">
                    <option value="trades" selected>Trade Logs</option>
                    <option value="general">General Logs</option>
                </select>
                <button id="clearTerminalBtn" class="btn btn-sm btn-outline-secondary" style="border-color: #3b3b4f; color: #a9b1d6;">Clear</button>
            </div>
        </div>
        <div class="card-body" id="tradeLogTerminal" style="height: 250px; overflow-y: auto; font-size: 13px; line-height: 1.5; padding: 10px; background-color: #1a1a26; border-radius: 0 0 4px 4px;">
            <div class="text-muted">Initializing live log polling...</div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const logTerminal = document.getElementById("tradeLogTerminal");
            const logTypeSelect = document.getElementById("logTypeSelect");
            const clearTerminalBtn = document.getElementById("clearTerminalBtn");

            let lastLogContent = "";

            function fetchLogs() {
                const logType = logTypeSelect.value;
                fetch(`/Home/PollLogs?type=${logType}&maxLines=100`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.lines) {
                            const content = data.lines.join("\n");
                            if (content !== lastLogContent) {
                                lastLogContent = content;

                                logTerminal.innerHTML = "";
                                if (data.lines.length === 0) {
                                    logTerminal.innerHTML = '<div class="text-muted">No logs found.</div>';
                                } else {
                                    data.lines.forEach(line => {
                                        const div = document.createElement("div");
                                        div.style.whiteSpace = "pre-wrap";
                                        div.style.wordBreak = "break-all";
                                        div.style.marginBottom = "4px";

                                        if (line.includes("[ERR]") || line.includes("Error") || line.includes("Exception") || line.includes("fail")) {
                                            div.style.color = "#f7768e";
                                        } else if (line.includes("[WRN]") || line.includes("Warning") || line.includes("warn")) {
                                            div.style.color = "#e0af68";
                                        } else if (line.includes("[INF]") || line.includes("Success") || line.includes("Buy") || line.includes("Sell")) {
                                            div.style.color = "#9ece6a";
                                        } else {
                                            div.style.color = "#a9b1d6";
                                        }

                                        div.textContent = line;
                                        logTerminal.appendChild(div);
                                    });

                                    logTerminal.scrollTop = logTerminal.scrollHeight;
                                }
                            }
                        } else {
                            logTerminal.innerHTML = `<div class="text-danger">Error: ${data.message || 'Unknown error'}</div>`;
                        }
                    })
                    .catch(error => {
                        console.error("Error polling logs:", error);
                        logTerminal.innerHTML = `<div class="text-danger">Connection lost: ${error.message}</div>`;
                    });
            }

            fetchLogs();

            const intervalId = setInterval(fetchLogs, 3000);

            logTypeSelect.addEventListener("change", function() {
                lastLogContent = "";
                logTerminal.innerHTML = '<div class="text-muted">Loading logs...</div>';
                fetchLogs();
            });

            clearTerminalBtn.addEventListener("click", function() {
                logTerminal.innerHTML = '<div class="text-muted">Terminal cleared.</div>';
                lastLogContent = "CLEARED";
            });
        });

        let parameterDriftChartInstance = null;

        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('parameterDriftChart');
            if (!ctx) return;

            fetch('/Home/GetParameterDrift')
                .then(response => response.json())
                .then(res => {
                    if (res.success && res.data) {
                        const isMock = res.data.is_mock;
                        const adjustments = res.data.adjustments || [];

                        const badge = document.getElementById('chartSourceBadge');
                        if (badge) {
                            if (isMock) {
                                badge.textContent = "Демо-режим (симуляция)";
                                badge.className = "badge badge-warning";
                            } else {
                                badge.textContent = "Реальные данные (ChromaDB)";
                                badge.className = "badge badge-success";
                            }
                        }

                        const labels = adjustments.map(item => {
                            const parts = item.timestamp.split(' ');
                            return parts.length > 1 ? parts[0] + " " + parts[1].substring(0, 5) : item.timestamp;
                        });

                        const buyTrailingData = adjustments.map(item => item.new_BuyTrailing);
                        const sellMarginData = adjustments.map(item => item.new_SellMargin);

                        const isLight = document.documentElement.classList.contains("light-theme");
                        const gridColor = isLight ? '#cbd5e1' : '#2b2b3f';
                        const tickColor = isLight ? '#4a5568' : '#a9b1d6';
                        const buyColor = isLight ? '#b83280' : '#f7768e';
                        const sellColor = isLight ? '#38a169' : '#9ece6a';

                        parameterDriftChartInstance = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [
                                    {
                                        label: 'BuyTrailing (%)',
                                        data: buyTrailingData,
                                        borderColor: buyColor,
                                        backgroundColor: isLight ? 'rgba(184, 50, 128, 0.05)' : 'rgba(247, 118, 142, 0.1)',
                                        borderWidth: 2,
                                        tension: 0.3,
                                        yAxisID: 'yBuy'
                                    },
                                    {
                                        label: 'SellMargin (%)',
                                        data: sellMarginData,
                                        borderColor: sellColor,
                                        backgroundColor: isLight ? 'rgba(56, 161, 105, 0.05)' : 'rgba(158, 206, 106, 0.1)',
                                        borderWidth: 2,
                                        tension: 0.3,
                                        yAxisID: 'ySell'
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    x: {
                                        grid: {
                                            color: gridColor
                                        },
                                        ticks: {
                                            color: tickColor
                                        }
                                    },
                                    yBuy: {
                                        type: 'linear',
                                        display: true,
                                        position: 'left',
                                        title: {
                                            display: true,
                                            text: 'BuyTrailing %',
                                            color: buyColor
                                        },
                                        grid: {
                                            color: gridColor
                                        },
                                        ticks: {
                                            color: buyColor
                                        }
                                    },
                                    ySell: {
                                        type: 'linear',
                                        display: true,
                                        position: 'right',
                                        title: {
                                            display: true,
                                            text: 'SellMargin %',
                                            color: sellColor
                                        },
                                        grid: {
                                            drawOnChartArea: false
                                        },
                                        ticks: {
                                            color: sellColor
                                        }
                                    }
                                },
                                plugins: {
                                    legend: {
                                        labels: {
                                            color: tickColor
                                        }
                                    }
                                }
                            }
                        });
                    }
                })
                .catch(err => {
                    console.error('Error fetching parameter drift:', err);
                });

            document.addEventListener("themeChanged", function (e) {
                const theme = e.detail.theme;
                const isLight = (theme === "light");
                const gridColor = isLight ? '#dee2e6' : '#2b2b3f';
                const tickColor = isLight ? '#2c3e50' : '#a9b1d6';
                const buyColor = isLight ? '#d9534f' : '#f7768e';
                const sellColor = isLight ? '#5cb85c' : '#9ece6a';

                if (window.parameterDriftChart) {
                    window.parameterDriftChart.options.scales.x.grid.color = gridColor;
                    window.parameterDriftChart.options.scales.x.ticks.color = tickColor;
                    window.parameterDriftChart.options.scales.yBuy.grid.color = gridColor;
                    window.parameterDriftChart.options.scales.yBuy.ticks.color = buyColor;
                    window.parameterDriftChart.options.scales.yBuy.title.color = buyColor;
                    window.parameterDriftChart.options.scales.ySell.ticks.color = sellColor;
                    window.parameterDriftChart.options.scales.ySell.title.color = sellColor;
                    window.parameterDriftChart.options.plugins.legend.labels.color = tickColor;

                    if (window.parameterDriftChart.data.datasets[0]) {
                        window.parameterDriftChart.data.datasets[0].borderColor = buyColor;
                        window.parameterDriftChart.data.datasets[0].backgroundColor = isLight ? 'rgba(217, 83, 79, 0.1)' : 'rgba(247, 118, 142, 0.1)';
                    }
                    if (window.parameterDriftChart.data.datasets[1]) {
                        window.parameterDriftChart.data.datasets[1].borderColor = sellColor;
                        window.parameterDriftChart.data.datasets[1].backgroundColor = isLight ? 'rgba(92, 184, 92, 0.1)' : 'rgba(158, 206, 106, 0.1)';
                    }

                    window.parameterDriftChart.update();
                }
            });
        });

        window.addEventListener('themeChanged', function (e) {
            if (parameterDriftChartInstance) {
                const isLight = e.detail.theme === 'light';
                const gridColor = isLight ? '#cbd5e1' : '#2b2b3f';
                const tickColor = isLight ? '#4a5568' : '#a9b1d6';
                const buyColor = isLight ? '#b83280' : '#f7768e';
                const sellColor = isLight ? '#38a169' : '#9ece6a';

                parameterDriftChartInstance.data.datasets[0].borderColor = buyColor;
                parameterDriftChartInstance.data.datasets[0].backgroundColor = isLight ? 'rgba(184, 50, 128, 0.05)' : 'rgba(247, 118, 142, 0.1)';
                parameterDriftChartInstance.data.datasets[1].borderColor = sellColor;
                parameterDriftChartInstance.data.datasets[1].backgroundColor = isLight ? 'rgba(56, 161, 105, 0.05)' : 'rgba(158, 206, 106, 0.1)';

                parameterDriftChartInstance.options.scales.x.grid.color = gridColor;
                parameterDriftChartInstance.options.scales.x.ticks.color = tickColor;
                parameterDriftChartInstance.options.scales.yBuy.grid.color = gridColor;
                parameterDriftChartInstance.options.scales.yBuy.ticks.color = buyColor;
                parameterDriftChartInstance.options.scales.yBuy.title.color = buyColor;
                parameterDriftChartInstance.options.scales.ySell.ticks.color = sellColor;
                parameterDriftChartInstance.options.scales.ySell.title.color = sellColor;
                parameterDriftChartInstance.options.plugins.legend.labels.color = tickColor;

                parameterDriftChartInstance.update();
            }
        });
    </script>
</div>
