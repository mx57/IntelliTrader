@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Instance"] = Model.InstanceName;
}

@section AddToHead{
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Static/Styles/Views/dashboard.css")">
    <script type="text/javascript" src="@Url.Content("~/Static/Scripts/Views/dashboard.js")"></script>
}

<div>
    <table class="table table-hover table-striped" id="tradingPairsTable" style="width: 100%">
        <thead>
            <tr>
                <th>More</th>
                <th>Pair</th>
                <th>Pair</th>
                <th>DCA</th>
                <th>Margin</th>
                <th>Target</th>
                <th>Rating</th>
                <th>Rating Bought</th>
                <th>Age</th>
                <th>Amount</th>
                <th>Cost</th>
                <th>Cost Bought</th>
                <th>Price</th>
                <th>Price Bought</th>
                <th>Spread</th>
                <th>Signal Rule</th>
                <th>Trading Rules</th>
                <th>Order Dates</th>
                <th>Order Ids</th>
            </tr>
        </thead>
        <tfoot>
            <tr>
                <th></th>
                <th>Total</th>
                <th>Total</th>
                <th></th>
                <th>Avg</th>
                <th></th>
                <th>Avg</th>
                <th>Avg</th>
                <th>Avg</th>
                <th></th>
                <th>Total</th>
                <th>Total</th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                </div>
                <div class="modal-body" id="modalContent"></div>
                <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/html" id="rowDetails">
        <div>
            <div class="row-details">
                <input type="hidden" id="pair" />
                <div class="additional-details">
                    <div id="swapPairContainer">
                        <span class="row-details-name">Swap Pair:</span>&nbsp;&nbsp;<span class="row-details-value" id="swapPair"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Signal Rule:</span>&nbsp;&nbsp;<span class="row-details-value" id="signalRule"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Trading Rules:</span>&nbsp;&nbsp;<span class="row-details-value" id="tradingRules"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Last Buy Margin:</span>&nbsp;&nbsp;<span class="row-details-value" id="lastBuyMargin"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Bought Price:</span>&nbsp;&nbsp;<span class="row-details-value" id="boughtPrice"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Bought Rating:</span>&nbsp;&nbsp;<span class="row-details-value" id="boughtRating"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Order Dates:</span>&nbsp;&nbsp;<span class="row-details-value" id="orderDates"></span>
                    </div>
                    <div>
                        <span class="row-details-name">Order Ids:</span>&nbsp;&nbsp;<span class="row-details-value" id="orderIds"></span>
                    </div>
                </div>
                <div class="show-settings">
                    <button class="btn btn-sm btn-success" onclick="showSettings(this);">Show Settings</button>
                </div>
                <div class="manual-order">
                    <span>Amount:</span>&nbsp;&nbsp;<input type="text" id="amount" />
                    <button class="btn btn-sm btn-info" onclick="sellPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Sell</button>
                    <button class="btn btn-sm btn-warning" onclick="buyPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Buy</button>
                    <button class="btn btn-sm btn-primary" onclick="swapPair(this);" @if (Model.ReadOnlyMode) { <text>disabled</text> }>Swap</button>
                </div>
            </div>
        </div>
    </script>

    <br />
    <div class="card mt-4" style="background-color: #1e1e2f; color: #a9b7c6; border: 1px solid #2d2d44; border-radius: 4px;">
        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #2b2b3d; border-bottom: 1px solid #2d2d44; padding: 10px 15px;">
            <h5 class="card-title mb-0" style="font-size: 1.1rem; font-weight: 600; color: #fff; margin: 0;">
                <i class="fas fa-terminal mr-2" style="color: #4fc3f7;"></i> Real-Time Logs
            </h5>
            <div class="d-flex align-items-center" style="gap: 15px;">
                <select id="logTypeSelect" class="form-control form-control-sm" style="width: auto; background-color: #1e1e2f; color: #fff; border: 1px solid #4e4e6a; height: 30px; padding: 2px 10px;">
                    <option value="trades">Trade Logs</option>
                    <option value="general">General Logs</option>
                </select>
                <span class="badge badge-success" id="logPollStatus" style="padding: 6px 10px; font-size: 0.75rem;">Polling Active</span>
                <button class="btn btn-sm btn-outline-secondary" id="clearTerminalBtn" style="color: #a9b7c6; border-color: #4e4e6a; height: 30px; padding: 2px 12px; line-height: 1.5;">Clear</button>
            </div>
        </div>
        <div class="card-body" style="padding: 15px;">
            <div id="logTerminal" style="height: 250px; overflow-y: auto; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.85rem; line-height: 1.4; background-color: #12121e; border: 1px solid #2d2d44; padding: 10px; border-radius: 4px; white-space: pre-wrap; word-wrap: break-word;">
                <div style="color: #6a737d;">Initializing log terminal...</div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const logTerminal = document.getElementById("logTerminal");
            const logPollStatus = document.getElementById("logPollStatus");
            const clearTerminalBtn = document.getElementById("clearTerminalBtn");
            const logTypeSelect = document.getElementById("logTypeSelect");

            let lastLinesJson = "";

            function pollLogs() {
                if (document.hidden) return;

                const logType = logTypeSelect ? logTypeSelect.value : "trades";
                fetch(`/Home/PollLogs?type=${logType}&count=100`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("HTTP status " + response.status);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data && data.success && Array.isArray(data.lines)) {
                            const currentJson = JSON.stringify(data.lines);
                            if (currentJson !== lastLinesJson) {
                                lastLinesJson = currentJson;
                                if (data.lines.length === 0) {
                                    logTerminal.innerHTML = '<div style="color: #6a737d;">No logs found for this category.</div>';
                                } else {
                                    logTerminal.innerHTML = data.lines.map(line => {
                                        if (line.includes("Error") || line.includes("Fatal") || line.includes("ERR")) {
                                            return `<div style="color: #f44336;">${escapeHtml(line)}</div>`;
                                        } else if (line.includes("Warning") || line.includes("WARN")) {
                                            return `<div style="color: #ffeb3b;">${escapeHtml(line)}</div>`;
                                        } else if (line.includes("TradeResult") || line.includes("Placed")) {
                                            return `<div style="color: #a5d6a7;">${escapeHtml(line)}</div>`;
                                        }
                                        return `<div>${escapeHtml(line)}</div>`;
                                    }).join("");
                                    logTerminal.scrollTop = logTerminal.scrollHeight;
                                }
                            }
                            if (logPollStatus) {
                                logPollStatus.textContent = "Polling Active";
                                logPollStatus.className = "badge badge-success";
                            }
                        } else {
                            if (logPollStatus) {
                                logPollStatus.textContent = "Data Error";
                                logPollStatus.className = "badge badge-warning";
                            }
                        }
                    })
                    .catch(err => {
                        console.error("Error polling logs:", err);
                        if (logPollStatus) {
                            logPollStatus.textContent = "Connection Error";
                            logPollStatus.className = "badge badge-danger";
                        }
                    });
            }

            function escapeHtml(text) {
                return text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            if (clearTerminalBtn) {
                clearTerminalBtn.addEventListener("click", function () {
                    logTerminal.innerHTML = '<div style="color: #6a737d;">Terminal cleared. Waiting for next poll...</div>';
                    lastLinesJson = "";
                });
            }

            if (logTypeSelect) {
                logTypeSelect.addEventListener("change", function () {
                    logTerminal.innerHTML = '<div style="color: #6a737d;">Switching log category...</div>';
                    lastLinesJson = "";
                    pollLogs();
                });
            }

            setInterval(pollLogs, 3000);
            pollLogs();

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden) {
                    pollLogs();
                }
            });
        });
    </script>
</div>
