@model AgentStatusViewModel
@{
    ViewData["Title"] = "Статус Агента";
    ViewData["Instance"] = Model.InstanceName;
}

<style>
    .agent-status-container {
        margin-top: 20px;
    }
    .metric-card {
        background-color: #2a2a3e;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.15);
        padding: 20px;
        margin-bottom: 25px;
        border-left: 5px solid #00bc8c;
    }
    .metric-card.drives {
        border-left-color: #375a7f;
    }
    .metric-title {
        font-size: 1.1rem;
        color: #888a9e;
        margin-bottom: 15px;
        text-transform: uppercase;
        font-weight: bold;
    }
    .metric-value {
        font-size: 2.5rem;
        font-weight: bold;
        color: #ffffff;
    }
    .drive-row {
        margin-bottom: 12px;
    }
    .drive-label {
        font-size: 0.95rem;
        color: #b8b9c4;
        display: flex;
        justify-content: space-between;
        margin-bottom: 4px;
    }
    .progress {
        background-color: #3e3f59;
        height: 18px;
        border-radius: 4px;
        overflow: hidden;
    }
    .progress-bar-energy {
        background-color: #00bc8c;
    }
    .progress-bar-boredom {
        background-color: #f39c12;
    }
    .section-header {
        font-size: 1.4rem;
        color: #ffffff;
        margin-top: 30px;
        margin-bottom: 15px;
        border-bottom: 2px solid #3e3f59;
        padding-bottom: 8px;
    }
    .task-card {
        background-color: #202030;
        border: 1px solid #3e3f59;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 15px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .task-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.25);
        border-color: #00bc8c;
    }
    .task-card.done {
        opacity: 0.85;
    }
    .task-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }
    .task-title {
        font-size: 1.15rem;
        font-weight: bold;
        color: #ffffff;
        margin-right: 15px;
    }
    .task-meta {
        margin-top: 4px;
    }
    .task-body {
        color: #b8b9c4;
        font-size: 0.95rem;
        margin-bottom: 10px;
    }
    .acceptance-list {
        background-color: #1a1a26;
        border-radius: 4px;
        padding: 10px 15px;
        margin-top: 8px;
    }
    .acceptance-list h6 {
        font-size: 0.85rem;
        color: #888a9e;
        text-transform: uppercase;
        margin-bottom: 6px;
        font-weight: bold;
    }
    .acceptance-item {
        font-size: 0.9rem;
        color: #a4a6b5;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
    }
    .acceptance-item i {
        margin-right: 8px;
        color: #00bc8c;
    }
</style>

<div class="agent-status-container">
    <div class="row">
        <!-- Блок Эпизодической Памяти -->
        <div class="col-md-6">
            <div class="metric-card">
                <div class="metric-title"><i class="fas fa-brain"></i> Эпизодическая Память (Episodic Memory)</div>
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="metric-value">@Model.EpisodicMemoryCount</div>
                        <p class="text-muted" style="margin-bottom: 0;">сохраненных событий в БД ChromaDB</p>
                    </div>
                    <i class="fas fa-database fa-3x" style="color: #00bc8c; opacity: 0.4;"></i>
                </div>
            </div>
        </div>

        <!-- Блок Когнитивных Драйвов -->
        <div class="col-md-6">
            <div class="metric-card drives">
                <div class="metric-title"><i class="fas fa-sliders-h"></i> Когнитивные Драйвы (Homeostatic Drives)</div>

                <!-- Энергия -->
                <div class="drive-row">
                    <div class="drive-label">
                        <span>Энергия (Energy)</span>
                        <span class="font-weight-bold">@((Model.Energy * 100).ToString("0"))%</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar progress-bar-energy" role="progressbar" style="width: @((Model.Energy * 100).ToString("0"))%" aria-valuenow="@(Model.Energy * 100)" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <!-- Скука -->
                <div class="drive-row">
                    <div class="drive-label">
                        <span>Скука (Boredom)</span>
                        <span class="font-weight-bold">@((Model.Boredom * 100).ToString("0"))%</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar progress-bar-boredom" role="progressbar" style="width: @((Model.Boredom * 100).ToString("0"))%" aria-valuenow="@(Model.Boredom * 100)" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Раздел: Активные задачи -->
    <div class="section-header"><i class="fas fa-tasks"></i> Активные задачи Агента (@Model.ActiveTasks.Count)</div>
    @if (Model.ActiveTasks.Count == 0)
    {
        <div class="alert alert-dark" role="alert">
            В данный момент нет активных или запланированных задач в очереди.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var task in Model.ActiveTasks)
            {
                <div class="col-md-12">
                    <div class="task-card">
                        <div class="task-header">
                            <span class="task-title">@task.Title</span>
                            <div class="task-meta">
                                <span class="badge badge-pill badge-primary">@task.Area.ToUpper()</span>

                                @if (task.Status == "running")
                                {
                                    <span class="badge badge-pill badge-info"><i class="fas fa-spinner fa-spin"></i> Выполняется</span>
                                }
                                else
                                {
                                    <span class="badge badge-pill badge-warning">В очереди</span>
                                }

                                @if (task.Risk == "low")
                                {
                                    <span class="badge badge-pill badge-success">Риск: Низкий</span>
                                }
                                else if (task.Risk == "medium")
                                {
                                    <span class="badge badge-pill badge-warning">Риск: Средний</span>
                                }
                                else
                                {
                                    <span class="badge badge-pill badge-danger">Риск: Высокий</span>
                                }
                            </div>
                        </div>
                        <div class="task-body">
                            @task.Description
                        </div>
                        @if (task.Acceptance != null && task.Acceptance.Count > 0)
                        {
                            <div class="acceptance-list">
                                <h6>Критерии приемки (Acceptance Criteria):</h6>
                                @foreach (var criteria in task.Acceptance)
                                {
                                    <div class="acceptance-item">
                                        <i class="far fa-check-square"></i> @criteria
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Раздел: Все задачи (История выполненных) -->
    <div class="section-header" style="margin-top: 40px;"><i class="fas fa-history"></i> Журнал выполнения задач (@Model.AllTasks.Count)</div>
    <div class="row">
        <div class="col-md-12" style="margin-bottom: 50px;">
            <table class="table table-hover table-striped" style="width: 100%; background-color: #1e1e2d; border-radius: 6px; overflow: hidden;">
                <thead>
                    <tr>
                        <th>ID Задачи</th>
                        <th>Название</th>
                        <th>Область</th>
                        <th>Сложность/Риск</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.AllTasks.OrderBy(t => t.Status == "done" ? 1 : 0))
                    {
                        <tr>
                            <td style="font-family: monospace;">@task.Id</td>
                            <td>@task.Title</td>
                            <td><span class="badge badge-dark">@task.Area</span></td>
                            <td>
                                @if (task.Risk == "low")
                                {
                                    <span class="badge badge-success">low</span>
                                }
                                else if (task.Risk == "medium")
                                {
                                    <span class="badge badge-warning">medium</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">@task.Risk</span>
                                }
                            </td>
                            <td>
                                @if (task.Status == "done")
                                {
                                    <span class="badge badge-success"><i class="fas fa-check"></i> Завершено</span>
                                }
                                else if (task.Status == "running")
                                {
                                    <span class="badge badge-info"><i class="fas fa-spinner fa-spin"></i> Выполняется</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">В очереди</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
